# Ignore everything
*

# Allow files and directories
!.github/
!.github/**
!.taskfiles/
!.taskfiles/**
!.editorconfig
!.gitignore
!.markdownlint.yaml
!.pre-commit-config.yaml
!.prettierignore
!.prettierrc.yaml
!.sops.yaml
!.terraform-docs.yaml
!.tflint.hcl
!.yamllint.yaml
!CODEOWNERS
!LICENSE
!README.md
!Taskfile.yaml

# Ignore unnecessary files and directories inside allowed directories
# This should go after the allowed directories
**/*~
**/*.log
**/.DS_Store
**/Thumbs.db
**/.terraform/**
**/.terraform.lock.hcl
**/*.tfbackend
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
